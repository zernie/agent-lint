{
  "_meta": {
    "purpose": "Tier-1 (REUSE) mapping for the vigiles rule-compiler: agent-prose intent -> the EXISTING off-the-shelf lint rule that already enforces it. When a repo declares an intent in prose (CLAUDE.md / AGENTS.md) but the mapped rule is off or absent in its ESLint config, the remedy is a one-line config change, NOT synthesis. The catalog is the SUPERSET the compiler routes against; the deterministic high-precision subset lives in src/rule-inventory.ts (INTENT_MAP) and is not edited here.",
    "how_to_read": "Each map entry: intent (human phrasing) -> keywords (prose forms AND rule-name/code tokens a human would write, so the classifier can match) -> existing (real, current rule ids to route to) -> config_fix (the one-line enable) -> optional note (type-aware requirement, heuristic caveat, deprecation/rename). semantic_no_existing lists intents that have NO off-the-shelf rule and fall through to synthesis or stay prose-only.",
    "sources": [
      "core = ESLint core (eslint)",
      "ts = typescript-eslint (@typescript-eslint/*)",
      "plugin:<pkg>:<rule> = eslint-plugin-<pkg>, where <rule> keeps its own plugin prefix"
    ],
    "coverage_note": "Covers the most common real-world agent-rule intents across the popular ESLint ecosystem: ESLint core, typescript-eslint, import, unicorn, sonarjs, promise, n (node), security, jsx-a11y, react, react-hooks, regexp, @eslint-community/eslint-comments, jest, vitest, testing-library, no-secrets. CORRECTNESS over quantity: every rule id below is a real, current rule of its plugin. Rules requiring TypeScript type information are flagged (note: type-aware); heuristic rules (security/*, no-secrets) are flagged as such.",
    "created": "2026-07-09",
    "updated": "2026-07-14"
  },
  "plugins": {
    "core": { "pkg": "eslint", "for": "The ESLint core rule set — language-level correctness, style, and complexity caps, no plugin needed." },
    "ts": { "pkg": "@typescript-eslint/eslint-plugin", "for": "TypeScript-aware rules; many of the strongest ones require type information (parserOptions.project / projectService)." },
    "import": { "pkg": "eslint-plugin-import", "for": "Module graph hygiene — cycles, resolution, ordering, dependency boundaries, default/named export policy." },
    "unicorn": { "pkg": "eslint-plugin-unicorn", "for": "Opinionated modern-JS best practices and idiom nudges (node: protocol, no forEach, no null, filename casing, ...)." },
    "sonarjs": { "pkg": "eslint-plugin-sonarjs", "for": "Bug-pattern and code-smell detectors ported from SonarQube — cognitive complexity, duplication, dead branches." },
    "promise": { "pkg": "eslint-plugin-promise", "for": "Promise usage correctness — return/throw discipline, no nesting, prefer async/await." },
    "n": { "pkg": "eslint-plugin-n", "for": "Node.js runtime rules (successor to eslint-plugin-node) — process.exit, deprecated/unsupported APIs, sync calls." },
    "security": { "pkg": "eslint-plugin-security", "for": "HEURISTIC static detectors for risky Node patterns (object injection, non-literal fs/regexp, child_process). High false-positive rate — advisory." },
    "jsx-a11y": { "pkg": "eslint-plugin-jsx-a11y", "for": "Accessibility checks on JSX — alt text, valid ARIA, interactive-element semantics, labels." },
    "react": { "pkg": "eslint-plugin-react", "for": "React-specific correctness and JSX idioms — keys, no bind-in-render, index keys, dangerous props." },
    "react-hooks": { "pkg": "eslint-plugin-react-hooks", "for": "The two Rules of Hooks — call order and effect dependency exhaustiveness." },
    "regexp": { "pkg": "eslint-plugin-regexp", "for": "Regex correctness, safety (ReDoS / super-linear backtracking) and readability." },
    "@eslint-community/eslint-comments": { "pkg": "@eslint-community/eslint-plugin-eslint-comments", "for": "Governs eslint-disable / eslint-enable directive comments — bans blanket disables, requires descriptions." },
    "jest": { "pkg": "eslint-plugin-jest", "for": "Jest test hygiene — no focused/disabled tests, expect discipline, title/structure conventions." },
    "vitest": { "pkg": "@vitest/eslint-plugin", "for": "Vitest test hygiene — mirror of the jest plugin for the Vitest runner." },
    "testing-library": { "pkg": "eslint-plugin-testing-library", "for": "Testing Library best practices — async query awaits, screen queries, no node access, no debug leftovers." },
    "no-secrets": { "pkg": "eslint-plugin-no-secrets", "for": "HEURISTIC high-entropy-string detector to catch committed API keys / tokens / credentials." },
    "boundaries": { "pkg": "eslint-plugin-boundaries", "for": "Architectural boundary enforcement by element type/layer — allowed-dependency rules between modules." }
  },
  "map": [

    { "intent": "no console.log / use structured logger", "keywords": ["console.log", "console\\.", "no-console", "use the logger", "structured log", "don't log to console"], "existing": ["core:no-console"], "config_fix": "\"no-console\": \"error\"", "note": "allow list e.g. { allow: [\"warn\", \"error\"] } if warn/error are intentional" },
    { "intent": "no debugger statements", "keywords": ["debugger", "no-debugger", "no debugger statement"], "existing": ["core:no-debugger"], "config_fix": "\"no-debugger\": \"error\"" },
    { "intent": "no alert / confirm / prompt", "keywords": ["no alert", "no-alert", "window.alert", "confirm(", "prompt("], "existing": ["core:no-alert"], "config_fix": "\"no-alert\": \"error\"" },
