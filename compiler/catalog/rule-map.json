    { "intent": "strict equality ===", "keywords": ["===", "strict equal", "eqeqeq", "no ==", "triple equals", "no loose equality"], "existing": ["core:eqeqeq"], "config_fix": "\"eqeqeq\": [\"error\", \"always\"]" },
