    { "intent": "no else after return / early return", "keywords": ["no-else-return", "early return", "no else after return", "guard clause"], "existing": ["core:no-else-return"], "config_fix": "\"no-else-return\": \"error\"" },
    { "intent": "switch must have default case", "keywords": ["default-case", "default case", "switch default"], "existing": ["core:default-case"], "config_fix": "\"default-case\": \"error\"", "note": "for exhaustive TS unions prefer @typescript-eslint/switch-exhaustiveness-check (type-aware) instead" },
