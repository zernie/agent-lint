    { "intent": "no magic numbers", "keywords": ["no-magic-numbers", "magic number", "named constant", "no literal number"], "existing": ["core:no-magic-numbers", "ts:@typescript-eslint/no-magic-numbers"], "config_fix": "\"@typescript-eslint/no-magic-numbers\": [\"error\", { \"ignore\": [0, 1] }]", "note": "high false-positive rate; usually scoped with ignore/ignoreArrayIndexes" },
